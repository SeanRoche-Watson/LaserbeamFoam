FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties.MolybdenumVapour;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// GENERATED by janafVapour/make_janaf_vapour.py - edit the script, not this file.
//
// Soft temperature ceiling via apparent heat capacity:
//   Cp/R = 2.5                        T <  10000 K
//   Cp/R = 2.5 + k (T - 10000)^2      T >= 10000 K,  k = 1.0139e-06 1/K^2
// Extra energy absorbed 10000 -> 30000 K = 10 x (1st+2nd ionisation) = 2.343e+08 J/kg.
// Cv = Cp - R:  130 J/kg/K below 10000 K; 35275 at 30000 K; 140710 at 5e4 K
// kappa (modified Eucken) = mu*Cv*(1.32 + 1.77 R/Cv), so kappa rises with Cv.
// Below 10000 K this reproduces the old eConst file (Cv = 130, Hf = 0) except
// that mu and kappa now go as sqrt(T).
// NOTE: perfectFluid (rho0 = 1) -> perfectGas. See README in this folder.

phaseState      gaseous;

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       sutherland;
    thermo          janaf;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleInternalEnergy;
}

TSolidus	5.0;
TLiquidus	10.0;
LatentHeat	1.0;
elec_conductivity	1.0;
magnetic_permeability	1.256e-6;

mixture
{
    specie
    {
        molWeight   95.95;
    }
    thermodynamics
    {
        Tlow            100;
        Thigh           500000;
        Tcommon         10000;
        highCpCoeffs    (1.0389448888e+02 -2.0278897777e-02 1.0139448888e-06 0.0000000000e+00 0.0000000000e+00 -3.3872700461e+05 -7.7414044431e+02);
        lowCpCoeffs     (2.5000000000e+00 0.0000000000e+00 0.0000000000e+00 0.0000000000e+00 0.0000000000e+00 -7.4537500000e+02 7.6455768293e+00);
    }
    transport
    {
        As          3.194510e-07;   // kappa = original const value 0.00734 W/m/K at 5000 K; ~0.8-1.4x original over 3-10 kK
        Ts          0;
    }
}

