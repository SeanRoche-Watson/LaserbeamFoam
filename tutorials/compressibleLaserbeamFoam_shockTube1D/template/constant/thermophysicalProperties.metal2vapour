FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties.ChromiumVapour;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// GENERATED by janafVapour/make_janaf_vapour.py - edit the script, not this file.
//
// Soft temperature ceiling via apparent heat capacity:
//   Cp/R = 2.5                        T <  10000 K
//   Cp/R = 2.5 + k (T - 10000)^2      T >= 10000 K,  k = 1.0132e-06 1/K^2
// Extra energy absorbed 10000 -> 30000 K = 10 x (1st+2nd ionisation) = 4.320e+08 J/kg.
// Cv = Cp - R:  240 J/kg/K below 10000 K; 65040 at 30000 K; 259440 at 5e4 K
// kappa (modified Eucken) = mu*Cv*(1.32 + 1.77 R/Cv), so kappa rises with Cv.
// Below 10000 K this reproduces the old eConst file (Cv = 240, Hf = 0) except
// that mu and kappa now go as sqrt(T).
// NOTE: perfectFluid (rho0 = 1) -> perfectGas. See README in this folder.

phaseState      gaseous;

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       sutherland;
    thermo          janaf;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleInternalEnergy;
}

TSolidus	5.0;
TLiquidus	10.0;
LatentHeat	1.0;
elec_conductivity	1.0;
magnetic_permeability	1.256e-6;

mixture
{
    specie
    {
        molWeight   52.0;
    }
    thermodynamics
    {
        Tlow            100;
        Thigh           500000;
        Tcommon         10000;
        highCpCoeffs    (1.0381743189e+02 -2.0263486378e-02 1.0131743189e-06 0.0000000000e+00 0.0000000000e+00 -3.3847014797e+05 -7.7444835132e+02);
        lowCpCoeffs     (2.5000000000e+00 0.0000000000e+00 0.0000000000e+00 0.0000000000e+00 0.0000000000e+00 -7.4537500000e+02 6.7435341664e+00);
    }
    transport
    {
        As          3.195622e-07;   // kappa = original const value 0.01355 W/m/K at 5000 K; ~0.8-1.4x original over 3-10 kK
        Ts          0;
    }
}

